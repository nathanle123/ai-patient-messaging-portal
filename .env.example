# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- PostgreSQL ---
POSTGRES_DB=portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=change-me

# Login for the similarity-search service's restricted database role. Hex only: openssl rand -hex 16
SEARCH_DB_PASSWORD=

# --- JWT (HS256). At least 32 bytes. Generate with: openssl rand -base64 48 ---
JWT_SECRET=
JWT_TTL=60m

# --- Demo accounts ---
# One shared password for all demo users (patients from fake_phi.csv, clinicians, admin). Min 8 chars.
SEED_DEMO_USERS=true
DEMO_USER_PASSWORD=

# --- Similar-message threshold (cosine). Tuned on seeded data: scripts/tune_similarity_threshold.py ---
SIMILARITY_THRESHOLD=0.52

# --- Demo seeding endpoint (POST /api/demo/messages: source tags, backdated times) ---
DEMO_MODE=true

# --- Host ports (bound to 127.0.0.1 only) ---
POSTGRES_HOST_PORT=5433
PLATFORM_HOST_PORT=8080
FRONTEND_HOST_PORT=3000
